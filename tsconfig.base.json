{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@tenarm/shared-ui": ["./libs/shared-ui/src/index.ts"],
      "@tenarm/flows-sell": ["./libs/flows/sell/src/index.ts"],
      "@tenarm/flows-buy": ["./libs/flows/buy/src/index.ts"],
      "@tenarm/flows-stock": ["./libs/flows/stock/src/index.ts"],
      "@tenarm/flows-money": ["./libs/flows/money/src/index.ts"],
      "@tenarm/data-hub-customers": ["./libs/data-hub/customers/src/index.ts"],
      "@tenarm/data-hub-suppliers": ["./libs/data-hub/suppliers/src/index.ts"],
      "@tenarm/data-hub-products": ["./libs/data-hub/products/src/index.ts"],
      "@tenarm/data-hub-accounts": ["./libs/data-hub/accounts/src/index.ts"],
      "@tenarm/dashboard": ["./libs/dashboard/src/index.ts"],
      "@tenarm/settings": ["./libs/settings/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
